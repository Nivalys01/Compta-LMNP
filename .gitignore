# =============================================================================
#  Dépôt Compta LMNP — exclusions à la racine
#
#  RÈGLE ABSOLUE : aucune donnée réelle dans ce dépôt. Un fichier committé
#  reste dans l'historique même après suppression. Les règles ci-dessous
#  doublent celles de compta_lmnp_v8.41.0/compta_lmnp/.gitignore : la
#  protection doit tenir même si l'arborescence est déplacée ou dupliquée.
# =============================================================================

# --- Anciennes versions de travail (contiennent des compta.db réels) --------
v_ant/

# --- Notes personnelles, hors périmètre du dépôt -----------------------------
Base de connaissances diverses/

# --- Documents de travail déposés à la racine --------------------------------
#     Un PDF comptable réel (bilan établi par un cabinet) y a séjourné sans
#     être ni suivi ni ignoré : un « git add -A » l'aurait publié, et le
#     contrôle de dépôt ne peut PAS voir dedans — le texte d'un PDF est
#     compressé, la recherche d'empreintes n'y trouve rien. Les documents
#     déposés à la racine sont donc exclus par principe ; un document qui
#     doit être versionné se met dans docs/.
/*.pdf
/*.docx
/*.xlsx
/*.odt

# --- Artefacts de build : le paquet client se régénère avec build_client.py --
*.zip
dist/
build/
*.spec

# --- Données réelles ---------------------------------------------------------
compta.db
*.db
*.db-journal
*.sqlite
*.sqlite3
reference/
seed_exemple.sql
sauvegardes/
archives/
dossiers/
dossiers.json
logs/
imports_tmp/

# --- FEC exportés (comptabilité réelle) — sauf le jeu de démo anonymisé -----
FEC*.txt
*FEC????????.txt
!demo/FEC_DEMO_*.txt

# --- Secrets -----------------------------------------------------------------
certs/
*.pem
*.key
.env

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Outils ------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Éditeurs / OS ------------------------------------------------------------
.~lock.*#
.vscode/
.idea/
.DS_Store
*.swp
